{
  "meta": {
    "schema_version": "4.3",
    "name": "Fear-Conditioning-Circuit",
    "description": "Lateral/central amygdala, intercalated cells and locus coeruleus. Attaches to the base model through free-standing projections and an augment."
  },
  "includes": [
    { "path": "neuromodulators.json", "root_namespace": true }
  ],
  "plasticity_rules": {
    "Fear_NE_STDP": {
      "coincidence_model": "AsymmetricSTDP",
      "params": {
        "tau_plus_ms": 20.0,
        "tau_minus_ms": 20.0,
        "a_plus": 0.03,
        "a_minus": 0.025
      },
      "trace_tau_ms": 1000.0,
      "base_transfer_rate": 0.00005,
      "modulator_couplings": [
        {
          "ligand": "NE",
          "reference": { "mode": "RunningAverage", "tau_ms": 5000.0 },
          "transfer_gain": 0.1,
          "transfer_function": { "type": "Rectified", "side": "Positive" }
        }
      ],
      "weight_dependence": "SoftBound",
      "w_min": 0.0,
      "w_max": 5.0
    }
  },
  "cell_types": {
    "LA_Principal": {
      "extends": "Pyramidal_RS",
      "params": { "d": 6.0 },
      "homeostasis": { "target_rate_hz": 3.0 }
    },
    "ITC_Cell": {
      "extends": "Basket_FS",
      "params": { "a": 0.02, "d": 4.0 }
    },
    "CeA_Output": {
      "extends": "Thalamic_Relay",
      "homeostasis": { "$replace": true, "enabled": false }
    }
  },
  "nuclei": [
    {
      "id": "locus_coeruleus",
      "coordinates_mm": [3.0, -30.0, -18.0],
      "radius_mm": 0.8,
      "size": 200,
      "composition": [
        { "cell_type": "Tonic_Pacemaker", "fraction": 1.0, "receptors": { "Soma": ["AMPA"] } }
      ],
      "projections": [
        {
          "id": "lc_to_lateral",
          "from_type": "Tonic_Pacemaker",
          "to_nucleus": "lateral",
          "to_type": "LA_Principal",
          "target_compartment": "ApicalDendrite",
          "topology": { "type": "FixedIndegree", "k": 10 },
          "conduction_velocity_m_s": 1.0,
          "transmitter": "NE",
          "synapse": {
            "weight_distribution": { "type": "Constant", "value": 1.0 },
            "stp_rule": "None",
            "ltp_rule": "None",
            "structural_plasticity": false
          }
        },
        {
          "id": "lc_cortical_volume",
          "from_type": "Tonic_Pacemaker",
          "to_nucleus": "cortex_S1_M1",
          "to_type": "Pyramidal_RS",
          "target_compartment": "ApicalDendrite",
          "release_mode": "Volume",
          "volume": { "arbors_per_source": 2, "sigma_mm": 0.8, "cutoff_mm": 2.0 },
          "conduction_velocity_m_s": 1.0,
          "transmitter": "NE",
          "synapse": {
            "weight_distribution": { "type": "Constant", "value": 1.0 },
            "stp_rule": "None",
            "ltp_rule": "None",
            "structural_plasticity": false
          }
        }
      ]
    },
    {
      "id": "lateral",
      "coordinates_mm": [20.0, -5.0, -20.0],
      "radius_mm": 1.5,
      "size": 800,
      "composition": [
        {
          "cell_type": "LA_Principal",
          "fraction": 0.85,
          "receptors": {
            "Soma": ["AMPA", "NMDA", "GABA_A"],
            "ApicalDendrite": ["AMPA", "NMDA", "Beta_Adrenergic"]
          }
        },
        { "cell_type": "Basket_FS", "fraction": 0.15, "receptors": { "Soma": ["AMPA"] } }
      ],
      "projections": [
        {
          "id": "la_to_interneurons",
          "from_type": "LA_Principal",
          "to_nucleus": "lateral",
          "to_type": "Basket_FS",
          "target_compartment": "Soma",
          "topology": { "type": "Random", "probability": 0.1 },
          "conduction_velocity_m_s": 0.5,
          "transmitter": "Glu",
          "synapse": {
            "weight_distribution": { "type": "LogNormal", "mu": 0.0, "sigma": 0.3 },
            "stp_rule": "Depressing_Glu",
            "ltp_rule": "None",
            "structural_plasticity": false
          }
        },
        {
          "id": "la_feedback_inhibition",
          "from_type": "Basket_FS",
          "to_nucleus": "lateral",
          "to_type": "LA_Principal",
          "target_compartment": "Soma",
          "topology": { "type": "Random", "probability": 0.2 },
          "conduction_velocity_m_s": 0.5,
          "transmitter": "GABA",
          "synapse": {
            "weight_distribution": { "type": "Gaussian", "mean": 1.5, "std": 0.2 },
            "stp_rule": "Depressing_GABA",
            "ltp_rule": "None",
            "structural_plasticity": false
          }
        },
        {
          "id": "la_to_central",
          "from_type": "LA_Principal",
          "to_nucleus": "central",
          "to_type": "CeA_Output",
          "target_compartment": "Soma",
          "topology": { "type": "Random", "probability": 0.05 },
          "conduction_velocity_m_s": 0.5,
          "transmitter": "Glu",
          "synapse": {
            "weight_distribution": { "type": "LogNormal", "mu": 0.0, "sigma": 0.3 },
            "stp_rule": "None",
            "ltp_rule": "None",
            "structural_plasticity": false
          }
        },
        {
          "id": "la_to_itc",
          "from_type": "LA_Principal",
          "to_nucleus": "itc",
          "to_type": "ITC_Cell",
          "target_compartment": "Soma",
          "topology": { "type": "Random", "probability": 0.05 },
          "conduction_velocity_m_s": 0.5,
          "transmitter": "Glu",
          "synapse": {
            "weight_distribution": { "type": "LogNormal", "mu": 0.0, "sigma": 0.3 },
            "stp_rule": "None",
            "ltp_rule": "None",
            "structural_plasticity": false
          }
        }
      ]
    },
    {
      "id": "itc",
      "coordinates_mm": [21.0, -5.0, -21.5],
      "radius_mm": 0.5,
      "size": 150,
      "composition": [
        { "cell_type": "ITC_Cell", "fraction": 1.0, "receptors": { "Soma": ["AMPA"] } }
      ],
      "projections": [
        {
          "id": "itc_gate",
          "from_type": "ITC_Cell",
          "to_nucleus": "central",
          "to_type": "CeA_Output",
          "target_compartment": "Soma",
          "topology": { "type": "Random", "probability": 0.2 },
          "conduction_velocity_m_s": 0.5,
          "transmitter": "GABA",
          "synapse": {
            "weight_distribution": { "type": "Gaussian", "mean": 1.0, "std": 0.1 },
            "stp_rule": "Depressing_GABA",
            "ltp_rule": "None",
            "structural_plasticity": false
          }
        }
      ]
    },
    {
      "id": "central",
      "coordinates_mm": [19.0, -6.0, -22.0],
      "radius_mm": 1.0,
      "size": 300,
      "composition": [
        { "cell_type": "CeA_Output", "fraction": 1.0, "receptors": { "Soma": ["AMPA", "GABA_A"] } }
      ],
      "projections": []
    }
  ],
  "projections": [
    {
      "id": "thalamo_amygdala_cs",
      "from_nucleus": "sensory_thalamus_vpl",
      "from_type": "Thalamic_Relay",
      "to_nucleus": "lateral",
      "to_type": "LA_Principal",
      "target_compartment": "ApicalDendrite",
      "topology": { "type": "Random", "probability": 0.01 },
      "conduction_velocity_m_s": 5.0,
      "transmitter": "Glu",
      "synapse": {
        "weight_distribution": { "type": "LogNormal", "mu": -0.5, "sigma": 0.4 },
        "stp_rule": "Depressing_Glu",
        "ltp_rule": "Fear_NE_STDP",
        "structural_plasticity": false
      }
    },
    {
      "id": "cortico_amygdala_cs",
      "from_nucleus": "cortex_S1_M1",
      "from_type": "Pyramidal_RS",
      "to_nucleus": "lateral",
      "to_type": "LA_Principal",
      "target_compartment": "ApicalDendrite",
      "topology": { "type": "Random", "probability": 0.002 },
      "conduction_velocity_m_s": 3.0,
      "transmitter": "Glu",
      "synapse": {
        "weight_distribution": { "type": "LogNormal", "mu": -0.5, "sigma": 0.4 },
        "stp_rule": "Depressing_Glu",
        "ltp_rule": "Fear_NE_STDP",
        "structural_plasticity": false
      }
    },
    {
      "id": "nociceptive_us",
      "from_nucleus": "nociceptive_relay",
      "from_type": "Thalamic_Relay",
      "to_nucleus": "lateral",
      "to_type": "LA_Principal",
      "target_compartment": "Soma",
      "topology": { "type": "FixedIndegree", "k": 20 },
      "conduction_velocity_m_s": 10.0,
      "transmitter": "Glu",
      "synapse": {
        "weight_distribution": { "type": "Constant", "value": 1.0 },
        "stp_rule": "None",
        "ltp_rule": "None",
        "structural_plasticity": false
      }
    },
    {
      "id": "nociceptive_to_lc",
      "from_nucleus": "nociceptive_relay",
      "from_type": "Thalamic_Relay",
      "to_nucleus": "locus_coeruleus",
      "to_type": "Tonic_Pacemaker",
      "target_compartment": "Soma",
      "topology": { "type": "FixedIndegree", "k": 20 },
      "conduction_velocity_m_s": 10.0,
      "transmitter": "Glu",
      "synapse": {
        "weight_distribution": { "type": "Constant", "value": 1.0 },
        "stp_rule": "None",
        "ltp_rule": "None",
        "structural_plasticity": false
      }
    }
  ],
  "augment": {
    "populations": [
      {
        "nucleus": "cortex_S1_M1",
        "population": "Pyramidal_RS",
        "add_receptors": { "ApicalDendrite": ["Beta_Adrenergic"] }
      }
    ]
  },
  "io_interfaces": {
    "motor_outputs": [
      {
        "id": "freezing_response",
        "source_nucleus": "central",
        "source_type": "CeA_Output",
        "source_subrange": [0.0, 1.0],
        "channel_axis": 0,
        "dimensions": 1,
        "decoding": "ExponentialRateTrace",
        "tau_trace_ms": 200.0,
        "rate_normalization_hz": 30.0,
        "output_gain": 1.0,
        "clamp_bounds": [0.0, 1.0]
      }
    ]
  }
}
