{
  "meta": {
    "schema_version": "4.3",
    "name": "Hippocampal-Memory-Loop",
    "description": "Entorhinal -> dentate (neurogenesis, calcium rule) -> CA3 (recurrent, Clopath, cholinergic presynaptic suppression) -> CA1 (multi-compartment, plateau BTSP, tag-and-capture) -> entorhinal."
  },
  "neurotransmitters": {
    "PRP": {
      "clearance_model": "ExponentialDecay",
      "baseline_ambient": 0.0,
      "clearance_tau_ms": 600000.0,
      "quantal_release": 1.0
    }
  },
  "receptors": {
    "NMDA_Ca": {
      "extends": "NMDA",
      "calcium_fraction": 0.1
    },
    "M_Presynaptic": {
      "ligand": "ACh",
      "kinetics": "MetabotropicLinearGain",
      "tau_rise_ms": 20.0,
      "tau_decay_ms": 500.0,
      "cellular_modulation": {
        "target": "PresynapticRelease",
        "projections": ["ca3_recurrent_collaterals"],
        "gain": -3.0,
        "reference": { "mode": "Fixed", "value": 0.2 },
        "min_factor": 0.2,
        "max_factor": 1.0
      }
    }
  },
  "plasticity_rules": {
    "Perforant_Calcium": {
      "coincidence_model": "CalciumControl",
      "params": {
        "tau_pre_ms": 20.0,
        "theta_d": 0.35,
        "theta_p": 0.55,
        "gamma_d": 0.0002,
        "gamma_p": 0.0005
      },
      "trace_tau_ms": 1.0,
      "base_transfer_rate": 1.0,
      "modulator_couplings": [],
      "w_min": 0.0,
      "w_max": 4.0
    },
    "CA3_Clopath": {
      "coincidence_model": "VoltageClopath",
      "params": {
        "a_ltd": 0.0001,
        "a_ltp": 0.00001,
        "theta_minus_mv": -60.0,
        "theta_plus_mv": -45.0,
        "tau_minus_ms": 10.0,
        "tau_plus_ms": 7.0,
        "tau_x_ms": 15.0
      },
      "trace_tau_ms": 1.0,
      "base_transfer_rate": 1.0,
      "modulator_couplings": [],
      "weight_dependence": "SoftBound",
      "w_min": 0.0,
      "w_max": 3.0
    },
    "CA1_BTSP": {
      "coincidence_model": "PlateauBTSP",
      "params": {
        "tau_et_ms": 1500.0,
        "tau_is_ms": 800.0,
        "eta": 0.3,
        "eta_depress": 0.02
      },
      "post_event_compartment": "ApicalTuft",
      "trace_tau_ms": 1.0,
      "base_transfer_rate": 1.0,
      "modulator_couplings": [],
      "weight_dependence": "SoftBound",
      "consolidation": {
        "early_decay_tau_ms": 1800000.0,
        "tag_threshold": 0.05,
        "capture_ligand": "PRP",
        "capture_compartment": "Soma",
        "capture_threshold": 0.1,
        "capture_rate": 0.0001
      },
      "w_min": 0.0,
      "w_max": 5.0
    }
  },
  "cell_types": {
    "Entorhinal_Stellate": {
      "extends": "Thalamic_Relay",
      "homeostasis": { "target_rate_hz": 5.0 }
    },
    "DG_Granule": {
      "model": "Izhikevich_1C",
      "compartments": ["Soma"],
      "params": {
        "a": 0.02, "b": 0.2, "c": -65.0, "d": 8.0,
        "v_peak_mv": 30.0, "refractory_ms": 2.0
      },
      "parameter_jitter": 0.03,
      "intrinsic_current": { "type": "None" },
      "calcium": {
        "tau_ms": 30.0,
        "spike_influx": { "Soma": 0.3 }
      },
      "homeostasis": {
        "enabled": true,
        "target_rate_hz": 1.0,
