    },
    "CA3_Pyramidal": {
      "extends": "Pyramidal_RS",
      "params": { "d": 6.0 }
    },
    "CA1_Pyramidal": {
      "model": "Izhikevich_MC",
      "compartments": ["Soma", "BasalDendrite", "ApicalDendrite", "ApicalTuft"],
      "params": {
        "a": 0.02, "b": 0.2, "c": -65.0, "d": 8.0,
        "v_peak_mv": 30.0, "refractory_ms": 2.0
      },
      "dendrites": {
        "BasalDendrite": {
          "parent": "Soma",
          "coupling_g": 0.1,
          "tau_ms": 15.0,
          "e_leak_mv": -65.0,
          "bap_kick_mv": 8.0
        },
        "ApicalDendrite": {
          "parent": "Soma",
          "coupling_g": 0.1,
          "tau_ms": 20.0,
          "e_leak_mv": -65.0,
          "bap_kick_mv": 10.0
        },
        "ApicalTuft": {
          "parent": "ApicalDendrite",
          "coupling_g": 0.05,
          "tau_ms": 25.0,
          "e_leak_mv": -65.0,
          "bap_kick_mv": 3.0,
          "plateau": {
            "g_max": 0.08,
            "v_half_mv": -30.0,
            "slope_mv": 3.0,
            "reversal_potential_mv": 0.0,
            "refractory_ms": 300.0
          }
        }
      },
      "parameter_jitter": 0.05,
      "intrinsic_current": { "type": "None" },
      "calcium": {
        "tau_ms": 25.0,
        "spike_influx": { "Soma": 0.5, "BasalDendrite": 0.3 },
        "plateau_influx_per_ms": 0.02
      },
      "activity_release": [
        {
          "ligand": "PRP",
          "compartment": "Soma",
          "event": "DendriticPlateau",
          "event_compartment": "ApicalTuft",
          "amount": 0.2
