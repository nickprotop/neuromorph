        "max_incoming_synapses": 400,
        "prune_weight_threshold": 0.02,
        "sprout_probability_per_sec": 0.05,
        "sprout_grace_period_ms": 5000.0
      }
    },
    "DG_Basket": {
      "extends": "Basket_FS",
      "structural_plasticity": {
        "max_incoming_synapses": 200,
        "prune_weight_threshold": 0.02,
        "sprout_probability_per_sec": 0.05,
        "sprout_grace_period_ms": 5000.0
