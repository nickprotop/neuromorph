      "homeostasis": {
        "enabled": true,
        "target_rate_hz": 2.0,
        "rate_estimate_tau_ms": 1000.0,
        "adaptation_tau_ms": 10000.0,
        "bias_gain": 0.5,
        "max_bias_current": 5.0
      }
    }
