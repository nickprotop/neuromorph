{
  "meta": {
    "schema_version": "4.3",
    "name": "Avoidance-Training-Harness",
    "description": "brain.json plus the controls and recording needed to train and test cue -> muscle avoidance. See docs/training.md.",
    "seed": 7
  },
  "includes": [
    { "path": "brain.json" }
  ],
  "recording": {
    "probes": [
      { "id": "muscles", "motor_output": "upper_limb_muscle_synergies", "sample_interval_ms": 10.0 },
      {
        "id": "corticospinal_weights",
        "projection": "corticospinal_pyramidal_tract",
        "selection": { "type": "Random", "count": 2000 },
        "sample_interval_ms": 1000.0,
        "variables": ["Weight", "Eligibility"]
      },
      {
        "id": "motor_dopamine",
        "nucleus": "motor_ventral_horn",
        "population": "Spinal_Alpha_Motor",
        "selection": { "type": "First", "count": 8 },
        "sample_interval_ms": 10.0,
        "variables": ["Ligand:DA@Soma"]
      },
      {
        "id": "cortex_rate",
        "nucleus": "cortex_S1_M1",
        "population": "Pyramidal_RS",
        "variables": ["PopulationRate"],
        "rate_window_ms": 100.0,
        "sample_interval_ms": 100.0
      },
      { "id": "learning_on", "control": "learning", "sample_interval_ms": 100.0 }
    ]
  },
  "runtime_controls": [
    { "id": "learning", "type": "PlasticityGate", "default": 1.0 },
    { "id": "sprouting", "type": "StructuralGate", "default": 1.0 }
  ]
}
